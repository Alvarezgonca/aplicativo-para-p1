# Copie para .env e troque os valores. O .env nao vai para o git.

# Senha do usuario do PostgreSQL (o docker-compose cria o banco com ela).
DB_PASSWORD=troque-esta-senha

# Chave que assina os tokens de acesso: pelo menos 32 caracteres aleatorios.
# Para gerar uma: openssl rand -base64 48
JWT_SECRET=troque-por-um-texto-aleatorio-de-pelo-menos-32-caracteres

# Enderecos que podem chamar a API pelo navegador (versao web do aplicativo).
CORS_ORIGENS=http://localhost:8081

# So para rodar a API fora do Docker (npm run dev), com o banco em outra porta:
# DB_HOST=localhost
# DB_PORT=5432
# PORT=3000
